#include <stdio.h>
#include <ctype.h> 

int main() {
    char ch;

   
    printf("Enter any character: ");
    scanf("%c", &ch);

    
    if (isalpha(ch)) {
        
        switch (ch) {
           
            case 'a':
            case 'e':
            case 'i':
            case 'o':
            case 'u':
            
            case 'A':
            case 'E':
            case 'I':
            case 'O':
            case 'U':
                printf("'%c' is a Vowel.\n", ch);
                break;
                
            
            default:
                printf("'%c' is a Consonant.\n", ch);
                break;
        }
    } else {
      
        printf("'%c' is not a valid alphabetic letter.\n", ch);
    }

    return 0;
}
